# checkpoints and weights
*.pt
*.pth
*.ckpt

# medical imaging data (never commit datasets)
*.nii
*.nii.gz

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# local outputs (figures/ and assets/ are the exception -- those get committed
# deliberately with small PNGs for the README; everything else in an output
# dir does not)
outputs/
runs/
*.csv.lock

# Slurm job logs (useful while debugging on Rangpur, not part of the
# submission itself)
slurm_*.out
slurm_*.err
